<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lives in the iadev.net/mac-resource-monitor/ IIS folder. IIS has no built-in
  MIME mapping for .dmg, so without this it serves the download as 404. This
  registers the type and disables caching of the appcast (versioned DMG URLs are
  new each release and cache fine; the appcast keeps the same URL with new
  content, so it must not be cached — mirror the Cloudflare purge step too).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".dmg" />
      <mimeMap fileExtension=".dmg" mimeType="application/x-apple-diskimage" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
